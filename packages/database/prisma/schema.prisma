generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Supabase's session pooler keeps Prisma Migrate independent from the
  // transaction pooler used by server runtime connections.
  directUrl = env("DIRECT_URL")
}

enum Role {
  VIEWER
  ADMIN
}

enum LiveStatus {
  READY
  LIVE
  ENDED
}

enum ChatMessageType {
  USER
  ADMIN
  SYSTEM
}

enum ChatMessageVisibility {
  VISIBLE
  HIDDEN
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponStatus {
  PUBLISHED
  DISABLED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum AiSuggestionType {
  CHAT_SUMMARY
}

enum AiSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String        @id @default(cuid())
  nickname           String
  role               Role
  createdAt          DateTime      @default(now()) @map("created_at")
  auditLogs          AuditLog[]
  chatMessages       ChatMessage[]
  chatTimeouts       ChatTimeout[] @relation("ChatTimeoutTarget")
  issuedChatTimeouts ChatTimeout[] @relation("ChatTimeoutActor")
  orders            Order[]
  reviewedAiSuggestions AiSuggestion[] @relation("AiSuggestionReviewer")
  announcements     Announcement[] @relation("AnnouncementCreator")

  @@map("users")
}

model LiveSession {
  id                String          @id @default(cuid())
  title             String
  status            LiveStatus      @default(READY)
  featuredProductId String?         @map("featured_product_id")
  featuredProduct   Product?        @relation("FeaturedProduct", fields: [featuredProductId], references: [id], onDelete: SetNull)
  startedAt         DateTime?       @map("started_at")
  endedAt           DateTime?       @map("ended_at")
  nextEventSequence Int             @default(1) @map("next_event_sequence")
  realtimeEvents    RealtimeEvent[]
  auditLogs         AuditLog[]
  chatRoom          ChatRoom?
  chatTimeouts      ChatTimeout[]
  coupons           Coupon[]
  orders            Order[]
  aiSuggestions     AiSuggestion[]
  announcements     Announcement[]

  @@map("live_sessions")
}

model ChatRoom {
  id           String        @id @default(cuid())
  liveId       String        @unique @map("live_id")
  live         LiveSession   @relation(fields: [liveId], references: [id], onDelete: Cascade)
  nextSequence Int           @default(1) @map("next_sequence")
  messages     ChatMessage[]

  @@map("chat_rooms")
}

model ChatMessage {
  id              String                @id @default(cuid())
  roomId          String                @map("room_id")
  room            ChatRoom              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId        String                @map("sender_id")
  sender          User                  @relation(fields: [senderId], references: [id], onDelete: Restrict)
  clientMessageId String                @map("client_message_id")
  sequence        Int
  type            ChatMessageType
  visibility      ChatMessageVisibility @default(VISIBLE)
  content         String                @db.VarChar(500)
  createdAt       DateTime              @default(now()) @map("created_at")

  @@unique([senderId, clientMessageId])
  @@unique([roomId, sequence])
  @@map("chat_messages")
}

model ChatTimeout {
  id        String      @id @default(cuid())
  liveId    String      @map("live_id")
  live      LiveSession @relation(fields: [liveId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id")
  user      User        @relation("ChatTimeoutTarget", fields: [userId], references: [id], onDelete: Restrict)
  actorId   String      @map("actor_id")
  actor     User        @relation("ChatTimeoutActor", fields: [actorId], references: [id], onDelete: Restrict)
  reason    String      @db.VarChar(300)
  expiresAt DateTime    @map("expires_at")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([liveId, userId, expiresAt])
  @@map("chat_timeouts")
}

model Coupon {
  id                String       @id @default(cuid())
  liveId            String       @map("live_id")
  live              LiveSession  @relation(fields: [liveId], references: [id], onDelete: Cascade)
  type              CouponType
  value             Int
  minOrderAmountKrw Int          @default(0) @map("min_order_amount_krw")
  startsAt          DateTime     @map("starts_at")
  endsAt            DateTime     @map("ends_at")
  usageLimit        Int?         @map("usage_limit")
  usedCount         Int          @default(0) @map("used_count")
  status            CouponStatus @default(PUBLISHED)
  createdAt         DateTime     @default(now()) @map("created_at")
  orders            Order[]

  @@index([liveId, status, startsAt, endsAt])
  @@map("coupons")
}

model RealtimeEvent {
  id          String      @id @default(cuid()) @map("event_id")
  liveId      String      @map("live_id")
  live        LiveSession @relation(fields: [liveId], references: [id], onDelete: Cascade)
  sequence    Int
  type        String
  payloadJson Json        @map("payload_json")
  occurredAt  DateTime    @default(now()) @map("occurred_at")

  @@unique([liveId, sequence])
  @@map("realtime_events")
}

model Product {
  id              String        @id @default(cuid())
  name            String
  description     String
  priceKrw        Int           @map("price_krw")
  variants        ProductVariant[]
  featuredInLives LiveSession[] @relation("FeaturedProduct")

  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  stock     Int
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id             String      @id @default(cuid())
  liveId         String      @map("live_id")
  live           LiveSession @relation(fields: [liveId], references: [id], onDelete: Cascade)
  userId         String      @map("user_id")
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  couponId       String?     @map("coupon_id")
  coupon         Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  idempotencyKey String      @map("idempotency_key")
  status         OrderStatus @default(PENDING)
  subtotalKrw    Int         @map("subtotal_krw")
  discountKrw    Int         @map("discount_krw")
  totalKrw       Int         @map("total_krw")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  items          OrderItem[]

  @@unique([userId, idempotencyKey])
  @@index([liveId, createdAt])
  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String         @map("order_id")
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String         @map("product_variant_id")
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  productId        String         @map("product_id")
  productName      String         @map("product_name")
  variantName      String         @map("variant_name")
  quantity         Int
  unitPriceKrw     Int            @map("unit_price_krw")

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

model AiSuggestion {
  id                 String             @id @default(cuid())
  liveId             String             @map("live_id")
  live               LiveSession        @relation(fields: [liveId], references: [id], onDelete: Cascade)
  type               AiSuggestionType
  provider           String             @db.VarChar(64)
  modelOrMockVersion String             @map("model_or_mock_version") @db.VarChar(128)
  inputHash          String             @map("input_hash") @db.VarChar(64)
  outputJson         Json               @map("output_json")
  status             AiSuggestionStatus @default(PENDING)
  reviewedById       String?            @map("reviewed_by")
  reviewedBy         User?              @relation("AiSuggestionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt         DateTime?          @map("reviewed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  announcement       Announcement?

  @@index([liveId, createdAt])
  @@index([reviewedById])
  @@map("ai_suggestions")
}

model Announcement {
  id                 String        @id @default(cuid())
  liveId             String        @map("live_id")
  live               LiveSession   @relation(fields: [liveId], references: [id], onDelete: Cascade)
  content            String        @db.VarChar(500)
  createdById        String        @map("created_by")
  createdBy          User          @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sourceSuggestionId String?       @unique @map("source_suggestion_id")
  sourceSuggestion   AiSuggestion? @relation(fields: [sourceSuggestionId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now()) @map("created_at")

  @@index([liveId, createdAt])
  @@index([createdById])
  @@map("announcements")
}

model AuditLog {
  id         String      @id @default(cuid())
  liveId     String      @map("live_id")
  live       LiveSession @relation(fields: [liveId], references: [id], onDelete: Cascade)
  actorId    String      @map("actor_id")
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  beforeJson Json?       @map("before_json")
  afterJson  Json?       @map("after_json")
  reason     String?
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([liveId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

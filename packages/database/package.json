{
  "name": "@liveflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "db:generate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "db:migrate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "db:migrate:reset": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate reset --schema prisma/schema.prisma",
    "db:seed": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  }
}

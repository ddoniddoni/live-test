    "test:integration": "vitest run src/health.integration.test.ts"
  },
  "dependencies": {
    "@liveflow/contracts": "0.1.0",
    "@liveflow/database": "0.1.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "fastify": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.0.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.20.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"

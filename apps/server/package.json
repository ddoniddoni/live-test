{
  "name": "@liveflow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc --project tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",

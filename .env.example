# Supabase Dashboard > Connect에서 복사한 앱용 Transaction Pooler connection string입니다.
# 서버 런타임은 보통 6543 포트와 `pgbouncer=true`를 사용합니다.
DATABASE_URL=postgresql://...

# Supabase Dashboard > Connect에서 복사한 migration용 Session Pooler connection string입니다.
# Prisma Migrate는 보통 5432 포트의 URL을 사용합니다. 브라우저에 노출하지 마세요.
DIRECT_URL=postgresql://...

# Use a long random value in each real environment. Never expose this value to the web app.
JWT_SECRET=replace-with-a-long-random-secret
DEMO_MODE=true
# Required only for the protected `/admin/lives/demo` demo route.
DEMO_ADMIN_PASSWORD=replace-with-a-strong-demo-password

# Comma-separated origins are supported for local development.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# The mock provider is the safe, no-cost default for the public demo.
AI_MODE=mock
OPENAI_API_KEY=

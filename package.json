{
  "name": "liveflow",
  "version": "0.1.0",
  "private": true,
  "description": "AI 기반 라이브커머스 데모 monorepo",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm run dev --workspace=@liveflow/web",
    "dev:server": "npm run dev --workspace=@liveflow/server",
    "build": "npm run build --workspace=@liveflow/contracts && npm run build --workspace=@liveflow/database && npm run build --workspace=@liveflow/server && npm run build --workspace=@liveflow/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build --workspace=@liveflow/contracts && npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@liveflow/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate --workspace=@liveflow/database",
    "db:migrate": "npm run db:migrate --workspace=@liveflow/database",
    "db:migrate:reset": "npm run db:migrate:reset --workspace=@liveflow/database",
    "db:seed": "npm run db:seed --workspace=@liveflow/database"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}

# E2E 전용 Supabase project의 connection string만 사용하세요.
# 이 DB는 `npm run test:e2e` 실행마다 migration과 seed가 다시 적용되며 기존 데이터가 삭제됩니다.
E2E_DATABASE_URL=postgresql://...
E2E_DIRECT_URL=postgresql://...

# 테스트 서버 전용 secret과 관리자 비밀번호입니다.
E2E_JWT_SECRET=replace-with-a-long-test-only-secret
E2E_DEMO_ADMIN_PASSWORD=replace-with-a-strong-test-only-password

# 전용 테스트 DB를 초기화한다는 명시적 동의값입니다.
E2E_ALLOW_DATABASE_RESET=true
